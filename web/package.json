{
  "name": "remars",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "desktop": "npm run desktop:dev",
    "desktop:dev": "npm run engine && npm run stage:desktop && node scripts/desktop-dev.mjs",
    "engine": "node scripts/build-engine.mjs",
    "stage:desktop": "node scripts/stage-desktop.mjs",
    "runtime": "node scripts/prepare-runtime.mjs",
    "dist:win": "npm run build && npm run engine && npm run stage:desktop && npm run runtime && electron-builder --win nsis"
  },
  "dependencies": {},
  "devDependencies": {
    "@base-ui/react": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.16.0",
    "next": "16.4.3",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.4"
  },
  "main": ".build/desktop/host.cjs",
  "description": "Modern desktop MIPS assembly environment powered by MARS 4.5.",
  "author": "reMARS",
  "build": {
    "appId": "com.remars.desktop",
    "productName": "reMARS",
    "artifactName": "reMARS-Setup-${version}.${ext}",
    "directories": { "output": "../desktop/build" },
    "files": ["out/**/*", ".build/desktop/**/*", "package.json"],
    "extraResources": [
      { "from": "../Mars45.jar", "to": "Mars45.jar" },
      { "from": "../MARSlicense.txt", "to": "MARSlicense.txt" },
      { "from": "../mars-engine/build/classes", "to": "engine" },
      { "from": ".build/runtime", "to": "runtime" }
    ],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "public/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
